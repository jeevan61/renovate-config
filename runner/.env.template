# GitHub token / bot account with repo read+write access.
# Used by Renovate to read dependency files and open pull requests.
RENOVATE_TOKEN=

# Private npm registry token (npmregistry.viewzenlabs.in), so Renovate can
# resolve @viewzen/* packages. Leave blank if not onboarding any JS repos yet.
VIEWZEN_NPM_TOKEN=

# "true" = safe mode, only logs what it would do, opens no PRs (default).
# Set to "false" only once a dry run has been checked and looks correct.
RENOVATE_DRY_RUN="true"
